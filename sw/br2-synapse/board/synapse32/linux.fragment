# Synapse-32 kernel: rv32imafd + Zve32f (TinyGPU v2 holds the FP and vector state), Sv32, no C.
CONFIG_32BIT=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
# CONFIG_RISCV_ISA_C is not set
CONFIG_FPU=y
CONFIG_RISCV_ISA_V=y
CONFIG_RISCV_ISA_V_DEFAULT_ENABLE=y
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_SMP is not set
# CONFIG_EFI is not set
# CONFIG_KVM is not set
# CONFIG_MODULES is not set
CONFIG_HZ_100=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_TIMER=y
CONFIG_OF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_EARLYCON=y
CONFIG_CMDLINE="console=ttyS0,115200 earlycon=uart8250,mmio32,0x20000000 rdinit=/init"
# Trim what an FPGA soft-core never uses
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_NFS_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_CGROUPS is not set
# CONFIG_PERF_EVENTS is not set
