# Synapse-32 + TinyGPU v2: RV32IMAFD Linux (ilp32d), Zve32f vector unit, OpenSBI fw_payload,
# BusyBox initramfs. Build:  make -C ~/opt/buildroot O=$PWD/out BR2_EXTERNAL=$PWD synapse32_defconfig
BR2_riscv=y
BR2_RISCV_32=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
# BR2_RISCV_ISA_RVC is not set
BR2_RISCV_ABI_ILP32D=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_12=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TARGET_GENERIC_HOSTNAME="synapse"
BR2_TARGET_GENERIC_ISSUE="Synapse-32 Linux"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.48"
BR2_LINUX_KERNEL_DEFCONFIG="rv32"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SYNAPSE_PATH)/board/synapse32/linux.fragment"
BR2_LINUX_KERNEL_IMAGE=y
# The device tree is compiled from board/synapse32/synapse32.dts with dtc (see
# board/synapse32/README) and handed to the kernel by OpenSBI, not built in the kernel tree.
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION_VALUE="1.5.1"
BR2_TARGET_OPENSBI_PLAT="generic"
BR2_TARGET_OPENSBI_LINUX_PAYLOAD=y
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="FW_TEXT_START=0x80000000 FW_PAYLOAD_ALIGN=0x1000 FW_FDT_PATH=$(BR2_EXTERNAL_SYNAPSE_PATH)/board/synapse32/synapse32.dtb PLATFORM_RISCV_ISA=rv32imafd_zicsr_zifencei PLATFORM_RISCV_ABI=ilp32d"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SYNAPSE_PATH)/board/synapse32/post-image.sh"
